#!/usr/bin/env python3
"""SVG Terminal Recorder - Record and render terminal sessions as SVG animations.

This script provides a command-line interface for recording terminal sessions
and rendering them as SVG animations or still frames.
"""

import logging
import sys
from typing import Optional, List

import svgterm.main

def setup_logging(debug: bool = False) -> None:
    """Configure logging for the application.
    
    Args:
        debug: If True, set log level to DEBUG
    """
    level = logging.DEBUG if debug else logging.INFO
    logging.basicConfig(
        level=level,
        format='%(asctime)s - %(name)s - %(levelname)s - %(message)s',
        datefmt='%Y-%m-%d %H:%M:%S'
    )

def main(args: Optional[List[str]] = None) -> int:
    """Main entry point for the svgterm CLI.
    
    Args:
        args: Command line arguments (default: sys.argv[1:])
        
    Returns:
        int: Exit code (0 for success, non-zero for errors)
    """
    try:
        # Set up basic logging
        setup_logging(debug=("--debug" in (args or [])))
        logger = logging.getLogger("svgterm.cli")
        
        # Run the main application
        svgterm.main.main(args)
        return 0
        
    except KeyboardInterrupt:
        logger.info("Operation cancelled by user")
        return 130  # Standard exit code for Ctrl+C
        
    except Exception as e:
        logger.critical(f"Unhandled error: {e}", exc_info=True)
        return 1

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
